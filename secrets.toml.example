# Secrets of the app: paste this (with your values) in Streamlit Community Cloud -> app -> Settings -> Secrets.
# For a local test copy it to .streamlit/secrets.toml (ignored by git), or leave DATASET_REPO out to use ./local_data.
HF_TOKEN = "hf_..."                                        # write access to the private dataset
DATASET_REPO = "yourname/counting-challenge-private"       # private dataset with ground_truth.csv
RANK_BY = "RMSE"                                           # RMSE, MAE or ACCURACY
MAX_SUBMISSIONS_PER_DAY = "5"
DEADLINE = "2026-12-20 23:59"                              # Italian time; remove the line for no deadline
SHOW_PRIVATE = "false"                                     # "true" at the end, with a Public / Private split
